{
  "extends": "./../tsconfig.json",
  "include": ["./simple", "./test_e2e/", "./issues/"],
  // Overrides the root config's "exclude" (which excludes ./samples). An empty array keeps every sample included.
  "exclude": [],
  "compilerOptions": {
    "module": "ESNext",
    "rootDir": "..",
    // The TreeShaking sample imports the package by name (bundled by scripts/build-tree-shaking-sample.mjs).
    "paths": {
      "rhodonite": ["./../dist/esmdev/index.d.ts"],
      "rhodonite/optional-materials": ["./../dist/esmdev/foundation/helpers/materials/optionalMaterials.d.ts"]
    },
    "declaration": false,
    "declarationDir": null,
    "lib": ["ES2022", "DOM", "ESNext"],
    "noImplicitAny": false,
    "strictNullChecks": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": false,
    "types": ["../node_modules/@types/webgl-ext/index.d.ts", "../node_modules/@types/webxr/index.d.ts"]
  }
}
